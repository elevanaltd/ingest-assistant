{
  "name": "ingest-assistant",
  "version": "3.0.2",
  "description": "AI-powered media file ingestion and metadata assistant with keyboard shortcuts, virtual scrolling, and enhanced security",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && electron .",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "package": "electron-builder",
    "postinstall": "electron-rebuild -f -w keytar && node -e \"const fs=require('fs'),path=require('path');['darwin-arm64','darwin-x64','win32-ia32','win32-x64','linux-arm','linux-arm64','linux-ia32'].forEach(p=>{const d=path.join('node_modules','@ffmpeg-installer',p);fs.mkdirSync(d,{recursive:true})})\"",
    "rebuild": "electron-rebuild -f -w keytar",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ai-structured": "tsc -p electron/tsconfig.json && node dist/electron/electron/scripts/test-structured-analysis.js",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "electron",
    "media",
    "ai",
    "metadata"
  ],
  "author": "Shaun Buswell <shaun.buswell@elevana.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/keytar": "^4.4.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "concurrently": "^8.2.2",
    "electron": "^39.2.5",
    "electron-builder": "^26.15.7",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^23.0.1",
    "typescript": "^5.3.3",
    "vite": "^7.2.6",
    "vite-plugin-electron": "^0.28.2",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "js-yaml": "^4.3.0",
    "keytar": "^7.9.0",
    "openai": "^6.9.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-window": "2.2.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "ws": "8.21.0",
    "ajv-formats": {
      "ajv": "^8.18.0"
    },
    "conf": {
      "ajv": "^8.18.0"
    }
  },
  "build": {
    "appId": "com.ingest-assistant",
    "productName": "Ingest Assistant",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "synopsis": "AI-powered media file ingestion and metadata assistant",
      "description": "Electron desktop application for batch processing media files with AI analysis and XMP metadata embedding."
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/@ffmpeg-installer/darwin-*",
      "!node_modules/@ffmpeg-installer/win32-*",
      "!node_modules/@ffmpeg-installer/linux-arm",
      "!node_modules/@ffmpeg-installer/linux-arm64",
      "!node_modules/@ffmpeg-installer/linux-ia32",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/*/ffmpeg",
      "node_modules/@ffprobe-installer/*/ffprobe",
      "node_modules/keytar/build/Release/*.node"
    ]
  }
}
